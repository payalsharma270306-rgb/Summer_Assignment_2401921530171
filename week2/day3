class Solution {
    public int strStr(String haystack, String needle) {
        return haystack.indexOf(needle);
    }
}


2. Is Subsequence:
class Solution {
    public boolean isSubsequence(String s, String t) {
        int i = 0;
        int j = 0;

        while (i < s.length() && j < t.length()) {
            if (s.charAt(i) == t.charAt(j)) {
                i++;
            }
            j++;
        }

        if (i == s.length()) {
            return true;
        } else {
            return false;
        }
    }
}


